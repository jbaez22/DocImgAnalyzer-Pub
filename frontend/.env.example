# Copy to .env.development or .env.production and fill in the values.

# Vite dev-server proxy target (dev only — not bundled)
DEV_API_PROXY_TARGET=https://your-api-domain.com

# API base URL baked into the production bundle
VITE_API_BASE_URL=https://your-api-domain.com

# Phase 2 — Cognito (get from: terraform output -raw cognito_user_pool_id)
VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
